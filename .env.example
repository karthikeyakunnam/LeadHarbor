# Run python3 scripts/setup.py to generate authentication secrets.
HOST=127.0.0.1
PORT=8080
PUBLIC_URL=http://localhost:8080
SECURE_COOKIES=false
DATABASE_PATH=data/leadharbor.sqlite3
ADMIN_PASSWORD_HASH=
ADMIN_TOKEN=
INGEST_TOKEN=
SESSION_SECRET=
DEMO_MODE=false
WORKER_ENABLED=true
RETENTION_DAYS=90
MAX_ATTEMPTS=3
SCORING_RULES_PATH=config/scoring.json
# Compatible chat-completions endpoint. For local Ollama, use host.docker.internal inside Docker.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_JSON_MODE=true
# Set your provider's current prices. Zero means unknown, never "free".
LLM_INPUT_PRICE_PER_MILLION=0
LLM_OUTPUT_PRICE_PER_MILLION=0
# Optional notifications: disabled while URL is empty. Delivery is at least once.
EVENT_WEBHOOK_URL=
EVENT_WEBHOOK_TOKEN=
# Optional n8n Docker profile. Configure an owner account in its UI.
N8N_ENCRYPTION_KEY=
N8N_PUBLIC_URL=http://localhost:5678/
N8N_SECURE_COOKIE=false
# Optional HTTPS reverse proxy profile. Replace with a domain you control.
DOMAIN=leads.example.com
